# Pinescript Bot — REAL PRODUCTION TRADING profile
# Real Delta orders + Google Sheets. Use only after paper/shadow validation.
BOT_NAME=Pinescript Bot
BOT_VERSION=1.4.0-final-complete
PINE_PARITY_MODE=true
LIVE_TICK_RISK_ENGINE=true

# REAL ORDER ROUTING: both switches below must be intentional.
EXECUTION_MODE=live
LIVE_TRADING_ENABLED=false
# Change LIVE_TRADING_ENABLED=true only when you are ready to send real orders.
DELTA_TESTNET=false
DELTA_API_KEY=PASTE_YOUR_LIVE_DELTA_API_KEY_HERE
DELTA_API_SECRET=PASTE_YOUR_LIVE_DELTA_API_SECRET_HERE
SYMBOL=BTC/USD:USD
DELTA_PRODUCT_SYMBOL=BTCUSD
ALERT_QTY=30

CANDLE_TIMEFRAME=30m
EMA_FAST_LEN=20
EMA_TREND_LEN=50
PINE_MINTICK=0.5
PINE_SLIPPAGE_TICKS=10
PINE_POINT_VALUE=0.001
PINE_ORDER_QTY=30
BINANCE_SIGNAL_FEED=false
BINANCE_SYMBOL=BTC/USDT

ATR_LEN=14
DI_LEN=14
ADX_SMOOTH=14
ADX_EMA=5
RSI_LEN=14
ADX_TREND_TH=20
ADX_RANGE_TH=18
ADX_TOLERANCE=0
FILTER_ATR_MULT=1.6
FILTER_BODY_MULT=0.4
FILTER_BODY_TOLERANCE=0
FILTER_VOL_ENABLED=true
FILTER_VOL_MULT=1.0
BREAKOUT_BUFFER_PTS=0
RSI_OB=70
RSI_OS=30
TREND_RR=5.0
RANGE_RR=3.0
TREND_ATR_MULT=0.9
RANGE_ATR_MULT=0.7
MAX_SL_MULT=2.0
MAX_SL_POINTS=1500
BE_MULT=1.0
TRAIL1_TRIGGER=1.0
TRAIL1_PTS=0.70
TRAIL1_OFF=0.55
TRAIL2_TRIGGER=2.0
TRAIL2_PTS=0.55
TRAIL2_OFF=0.45
TRAIL3_TRIGGER=3.0
TRAIL3_PTS=0.45
TRAIL3_OFF=0.35
TRAIL4_TRIGGER=5.0
TRAIL4_PTS=0.30
TRAIL4_OFF=0.25
TRAIL5_TRIGGER=8.0
TRAIL5_PTS=0.20
TRAIL5_OFF=0.15
COMMISSION_PCT=0.05

TP_HARD_EXIT=true
BAR_CLOSE_SL_EVAL=false
TIME_EXIT_MINUTES=0
TRAIL_SL_PRE_FIRE_BUFFER=0
TRAIL_OFFSET_FLOOR_MULT=0
TRAIL_ARM_FLOOR_MULT=0
SL_CONFIRM_MS=0
SL_CONFIRM_TICKS=1
TRAIL_SL_CONFIRM_TICKS=1
TRAIL_EXIT_FROM_DELTA_WS=true
TRAIL_FIRE_SL_ON_CANDLE_EXTREME=false
EMERGENCY_BRACKET_ENABLED=true
BRACKET_SL_WIDEN_MULT=3.0
BRACKET_SL_MIN_PTS=300
BRACKET_SL_BUFFER=10
SL_FIRE_VIA_BRACKET=false
MAX_EXIT_SLIPPAGE_ATR_PCT=25
TRAIL_LOOP_SEC=0.25
WS_RECONNECT_SEC=5
MAX_ENTRY_SLIP_ATR_FRAC=0.30

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_THIS_PASSWORD
CLIENT_DASHBOARD_PORT=8081
LOG_FILE=./data/pinescript_bot_journal.db

GSHEET_ENABLED=true
GSHEET_AUTO_CREATE=true
GSHEET_SPREADSHEET_ID=PASTE_GOOGLE_SHEET_ID_HERE
GSHEET_CREDENTIALS_FILE=./secrets/google-service-account.json
GSHEET_CREDENTIALS_JSON=
